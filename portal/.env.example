# Copy to .env on the server. Do not commit the real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-key
# Hostnames/IPs only: no http:// and no port. Replace the example IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
# Same-origin access via the IP does not require trusted origins.
DJANGO_CSRF_TRUSTED_ORIGINS=
PORTAL_PORT=8000
